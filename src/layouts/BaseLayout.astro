---
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.jpg', Astro.site);

const homeUrl = new URL('/', Astro.site).href;

// Los perfiles sociales solo entran cuando son reales (no el placeholder sin handle).
const perfilesSociales = [site.instagram].filter((url) => new URL(url).pathname.length > 1);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'ProfessionalService',
  '@id': `${homeUrl}#organizacion`,
  name: site.name,
  description: site.description,
  url: homeUrl,
  email: site.email,
  image: ogImage.href,
  logo: new URL('/favicon-loc.png', Astro.site).href,
  address: {
    '@type': 'PostalAddress',
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    addressCountry: site.address.country,
  },
  // Madrid primero: es el mercado prioritario para SEO.
  // TODO: añadir los países de Latam cuando se concreten, como entradas
  // `{ '@type': 'Country', name: 'México' }` en esta misma lista. "Latam" a secas
  // no es un lugar que Google pueda interpretar. No crear un segundo bloque
  // ProfessionalService: duplicaría la entidad.
  areaServed: [
    { '@type': 'City', name: 'Madrid' },
    { '@type': 'Country', name: 'España' },
  ],
  knowsLanguage: 'es',
  serviceType: [
    'Marketing gastronómico',
    'Gestión de redes sociales para restaurantes',
    'Producción audiovisual',
    'Fotografía gastronómica',
    'Diseño web para restaurantes',
    'Email marketing',
  ],
  ...(perfilesSociales.length > 0 && { sameAs: perfilesSociales }),
  // TODO: añadir `telephone` cuando haya número real.
};
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical.href} />

    {/* Los tres iconos salen del mismo lockup: ver public/favicon-loc.png. */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/favicon-loc.png" type="image/png" sizes="256x256" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      href="/fonts/dm-serif-display-latin-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin-var.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content="es_ES" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    {/* TODO: falta la og image definitiva en public/og-image.jpg (1200×630). */}
    <meta property="og:image" content={ogImage.href} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage.href} />

    <meta name="theme-color" content="#080808" />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-[100] focus:flex focus:min-h-11 focus:items-center focus:bg-bone focus:px-6 focus:text-[11px] focus:font-semibold focus:tracking-[.2em] focus:text-ink focus:uppercase"
    >
      Saltar al contenido
    </a>
    <slot />
  </body>
</html>
