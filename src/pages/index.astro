---
// Clientes ("Han confiado en nosotros") y Testimonio: ocultas a la espera de
// logos y de un testimonio real. Los componentes siguen en src/components/.
// import Clientes from '../components/Clientes.astro';
import CtaFinalModal from '../components/CtaFinalModal.astro';
import Equipo from '../components/Equipo.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import Manifiesto from '../components/Manifiesto.astro';
// Marquesina de disciplinas: oculta mientras se decide la banda de
// restaurantes. Copia intacta en design/backups/Marquee.astro.bak.
// import Marquee from '../components/Marquee.astro';
import MobileMenu from '../components/MobileMenu.astro';
import Principios from '../components/Principios.astro';
import Proceso from '../components/Proceso.astro';
import RestaurantesEspaciado from '../components/RestaurantesEspaciado.astro';
// Variante A (logos separados por el rombo): descartada a favor de la de
// espaciado. El componente sigue en src/components/RestaurantesRombo.astro.
// import RestaurantesRombo from '../components/RestaurantesRombo.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Servicios from '../components/Servicios.astro';
// import Testimonio from '../components/Testimonio.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <Header />
  <MobileMenu />

  <main id="main" data-outside>
    <Hero />
    <RestaurantesEspaciado />
    <Manifiesto />
    <Servicios />
    <Principios />
    <SelectedWork />
    <Equipo />
    <Proceso />
    <Faq />
    <CtaFinalModal />
  </main>

  <Footer />
</BaseLayout>

<script>
  import { initCarrusel } from '../scripts/carrusel';
  import { initHoverCursors } from '../scripts/hover-cursor';
  import { initReveals } from '../scripts/reveal';

  initReveals();
  // El cursor cubre dos secciones (Proyectos y Servicios): se inicializa aquí.
  initHoverCursors();
  // El carrusel monta Proyectos (y Testimonios cuando vuelva a la página) con
  // una sola llamada, y así ninguno se monta por duplicado.
  initCarrusel();
</script>
