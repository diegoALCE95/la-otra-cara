---
import { faq } from '../data/faq';
import Eyebrow from './ui/Eyebrow.astro';
import SectionShell from './ui/SectionShell.astro';

/**
 * Seis preguntas como máximo, en acordeón de una abierta a la vez
 * (`faq-acordeon.ts`, el mismo motor que el acordeón de servicios: el estado
 * vive en `aria-expanded` y la altura la anima el CSS de 0fr a 1fr).
 */
---

<SectionShell id="faq" class="border-t border-hair-gold bg-ink">
  <div data-reveal class="reveal flex flex-wrap items-end justify-between gap-6">
    <h2 class="m-0 max-w-[24ch] font-display text-h2-team font-normal text-pretty">
      Las dudas también tienen <em class="text-gold italic">otra cara</em>: una respuesta clara.
    </h2>
    <Eyebrow tracking="tracking-[.3em]">Preguntas frecuentes</Eyebrow>
  </div>

  <div
    data-faq-list
    data-reveal-group
    class="mt-[clamp(44px,8vh,90px)] border-t border-hair"
  >
    {
      /* Cada fila va envuelta: el reveal usa `transition`, y el botón ya tiene
         la suya para el hover. Separarlas evita que compitan. */
      faq.map((item, i) => (
        <div data-reveal class="reveal [--reveal-dur:.9s] [--reveal-y:18px]">
          <div class="border-b border-hair">
            <h3 class="m-0">
              <button
                type="button"
                data-faq-toggle
                aria-expanded="false"
                aria-controls={`faq-panel-${i + 1}`}
                class="group flex w-full cursor-pointer items-center gap-[clamp(16px,3vw,48px)] border-0 bg-transparent py-[clamp(20px,3vh,32px)] pr-[clamp(14px,2.2vw,32px)] pl-1 text-left transition-[padding-left,background-color] duration-500 ease-editorial hover:bg-wash hover:pl-[18px] focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-gold"
              >
                <span class="min-w-0 flex-1 font-display text-card font-normal text-bone">
                  {item.pregunta}
                </span>
                {/* + que se convierte en − al abrir: dos hairlines cruzadas, la
                    vertical se repliega sobre la horizontal. */}
                <span
                  aria-hidden="true"
                  class="relative block size-[13px] flex-none text-gold"
                >
                  <span class="absolute top-1/2 left-0 block h-px w-full -translate-y-1/2 bg-current" />
                  <span class="absolute top-0 left-1/2 block h-full w-px -translate-x-1/2 bg-current transition-transform duration-500 ease-editorial group-aria-expanded:scale-y-0" />
                </span>
              </button>
            </h3>

            {/* Acordeón: `grid-template-rows` de 0fr a 1fr es lo único que anima
                una altura desconocida sin medirla en JS. */}
            <div
              id={`faq-panel-${i + 1}`}
              data-open="false"
              inert
              class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-[560ms] ease-editorial data-[open=true]:grid-rows-[1fr]"
            >
              <div class="overflow-hidden">
                <p class="m-0 max-w-[62ch] pr-[clamp(14px,2.2vw,32px)] pb-[clamp(22px,3.4vh,34px)] pl-1 text-[15px]/[1.75] font-light text-pretty text-bone-55">
                  {item.respuesta}
                </p>
              </div>
            </div>
          </div>
        </div>
      ))
    }
  </div>
</SectionShell>

<script>
  import { initFaqAcordeon } from '../scripts/faq-acordeon';

  initFaqAcordeon();
</script>
