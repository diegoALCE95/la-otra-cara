---
import type { Proyecto } from '../data/proyectos';
import ImagePlaceholder from './ui/ImagePlaceholder.astro';

interface Props {
  proyecto: Proyecto;
  /** Posición en la galería del visor (`data-lb-open="work:<índice>"`). */
  index: number;
  /** Clase de delay del reveal, p.ej. '[--reveal-delay:.12s]'. */
  delay?: string;
  /** El destacado ancho usa la escala de título mayor. */
  wide?: boolean;
  class?: string;
}

const { proyecto, index, delay = '', wide = false, class: extra = '' } = Astro.props;
---

<a
  href="#proyectos"
  data-lb-open={`work:${index}`}
  data-cursor-target
  aria-haspopup="dialog"
  data-reveal
  class:list={[
    'group reveal block text-bone [--reveal-y:24px]',
    proyecto.desfasado && 'self-end',
    delay,
    extra,
  ]}
>
  <div class:list={['relative w-full overflow-hidden bg-ink-well', proyecto.ratio]}>
    <div
      class="absolute inset-0 transition-[scale] duration-[1100ms] ease-editorial group-hover:scale-[1.045]"
    >
      <ImagePlaceholder label={proyecto.placeholder} />
    </div>
  </div>
  <div
    class:list={[
      'mt-4 flex items-baseline justify-between gap-4 border-t border-hair pt-4',
      wide && 'flex-wrap',
    ]}
  >
    <span>
      <span class:list={['block font-display', wide ? 'text-card-wide' : 'text-card']}
        >{proyecto.titulo}</span
      >
      <span class="mt-1.5 block text-[11px] tracking-[.2em] text-bone-45 uppercase"
        >{proyecto.categoria}</span
      >
    </span>
    <span class="font-display text-[13px] text-gold">{proyecto.anio}</span>
  </div>
</a>
