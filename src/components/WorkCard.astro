---
import { Image } from 'astro:assets';

import type { Proyecto } from '../data/proyectos';

interface Props {
  proyecto: Proyecto;
  /** Posición en la galería del visor (`data-lb-open="work:<índice>"`). */
  index: number;
  class?: string;
}

const { proyecto, index, class: extra = '' } = Astro.props;
---

<a
  href="#proyectos"
  data-lb-open={`work:${index}`}
  data-cursor-target
  aria-haspopup="dialog"
  class:list={[
    'group block text-bone focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-gold',
    extra,
  ]}
>
  <div class:list={['relative w-full overflow-hidden bg-ink-well', proyecto.ratio]}>
    <div
      class="absolute inset-0 transition-[scale] duration-[1100ms] ease-editorial group-hover:scale-[1.045]"
    >
      <Image
        src={proyecto.poster}
        alt={`Fotograma del vídeo de ${proyecto.titulo}`}
        widths={[420, 640, 960]}
        sizes="(min-width: 900px) 30vw, 92vw"
        loading="lazy"
        decoding="async"
        class="size-full object-cover"
      />
    </div>
  </div>
  <div class="mt-4 flex items-baseline justify-between gap-4 border-t border-hair pt-4">
    <span>
      <span class="block font-display text-card">{proyecto.titulo}</span>
      {
        proyecto.categoria && (
          <span class="mt-1.5 block text-[11px] tracking-[.2em] text-bone-45 uppercase">
            {proyecto.categoria}
          </span>
        )
      }
    </span>
    <span class="font-display text-[13px] text-gold">{proyecto.anio}</span>
  </div>
</a>
