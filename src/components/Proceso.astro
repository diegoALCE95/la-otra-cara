---
import { proceso } from '../data/proceso';
import ProcesoDial from './ProcesoDial.astro';
import Eyebrow from './ui/Eyebrow.astro';
import SectionShell from './ui/SectionShell.astro';

const delays = ['', '[--reveal-delay:.1s]', '[--reveal-delay:.2s]', '[--reveal-delay:.3s]'];
---

<SectionShell
  py="py-[clamp(90px,15vh,190px)]"
  class="relative overflow-hidden bg-bone text-ink"
  innerClass="relative"
>
  <div
    slot="bleed"
    aria-hidden="true"
    class="pointer-events-none absolute right-[-4vw] bottom-[-11vh] font-display text-watermark whitespace-nowrap text-watermark-ink italic select-none"
  >
    cocina
  </div>

  <ProcesoDial />

  <Eyebrow
    data-reveal
    ruleClass="bg-hair-ink-rule-soft"
    tone="stone"
    tracking="tracking-[.28em]"
    class="reveal relative mb-[clamp(32px,6vh,64px)]">Cómo trabajamos</Eyebrow
  >

  <h2
    data-reveal
    class="reveal relative m-0 max-w-[16ch] font-display text-h2-manifesto font-normal text-pretty [--reveal-delay:.08s] [--reveal-y:26px]"
  >
    Así se cocina <em class="text-gold-deep italic">una estrategia</em>
  </h2>

  <p
    data-reveal
    class="reveal relative mt-[clamp(20px,3.4vh,34px)] mb-0 max-w-[44ch] text-body font-light text-graphite [--reveal-delay:.16s] [--reveal-y:20px]"
  >
    ¿Qué pasa después de que un restaurante nos contacte?
  </p>

  <div
    class="relative mt-[clamp(48px,9vh,110px)] grid grid-cols-2 gap-[clamp(28px,3vw,56px)] lg:grid-cols-4"
  >
    {
      proceso.map((paso, i) => (
        <div
          data-reveal
          class:list={[
            'reveal group relative border-t border-hair-ink-strong pt-[26px] [--reveal-dur:.9s] [--reveal-y:20px]',
            delays[i],
          ]}
        >
          {/* Acento dorado tumbado sobre la hairline: crece al pasar el cursor. */}
          <span
            aria-hidden="true"
            class="absolute top-[-1px] left-0 block h-px w-[34px] bg-gold-deep transition-[width] duration-700 ease-editorial group-hover:w-[76px]"
          />
          <span class="block font-display text-step text-ink">{paso.numero}</span>
          <span class="mt-[18px] block text-[11px] font-semibold tracking-[.24em] uppercase">
            {paso.titulo}
          </span>
          <p class="mt-3 mb-0 max-w-[32ch] text-[14px]/[1.65] font-light text-graphite-soft">
            {paso.apoyo}
          </p>
        </div>
      ))
    }
  </div>
</SectionShell>
