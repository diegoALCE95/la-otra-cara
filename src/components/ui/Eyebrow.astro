---
/** Eyebrow de sección: numeral serif opcional + raya de 56px opcional + label. */
interface Props {
  numero?: string;
  /** Clase de fondo de la raya de 56px. Sin valor, no se dibuja la raya. */
  ruleClass?: string;
  tone?: 'gold' | 'gold-deep' | 'stone';
  tracking?: string;
  class?: string;
  /** El resto de atributos (p. ej. `data-reveal`) va al contenedor. */
  [key: string]: unknown;
}

const {
  numero,
  ruleClass,
  tone = 'gold',
  tracking = 'tracking-[.26em]',
  class: extra = '',
  ...atributos
} = Astro.props;

const toneClass = {
  gold: 'text-gold',
  'gold-deep': 'text-gold-deep',
  stone: 'text-stone',
}[tone];
---

<div class:list={['flex items-center gap-[14px]', extra]} {...atributos}>
  {numero && <span class="font-display text-[13px] text-gold-deep">{numero}</span>}
  {ruleClass && <span aria-hidden="true" class:list={['block h-px w-[56px]', ruleClass]} />}
  <span class:list={['text-[11px] font-semibold uppercase', tracking, toneClass]}>
    <slot />
  </span>
</div>
