---
import ManifiestoRings from './ManifiestoRings.astro';
import Eyebrow from './ui/Eyebrow.astro';
import SectionShell from './ui/SectionShell.astro';
---

<SectionShell
  id="agencia"
  py="py-[clamp(90px,15vh,190px)]"
  class="relative overflow-hidden bg-bone text-ink"
  innerClass="relative"
>
  <div
    slot="bleed"
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[-6vh] left-[-4vw] font-display text-watermark whitespace-nowrap text-watermark-ink italic select-none"
  >
    cara
  </div>

  <!-- <Eyebrow
    data-reveal
    numero="02"
    ruleClass="bg-hair-ink-rule"
    tone="stone"
    class="reveal relative mb-[clamp(32px,6vh,64px)]">AGENCIA</Eyebrow
  > -->
  {/* El bloque de encabezado da la altura de referencia: los anillos se centran
      en ella, de modo que titular y animación comparten eje y no rozan la
      hairline de abajo. */}
  <div
    class="relative lg:flex lg:min-h-[calc(clamp(240px,27vw,440px)+clamp(56px,9vh,112px))] lg:flex-col lg:justify-center"
  >
    <ManifiestoRings />

    <Eyebrow
      data-reveal
      ruleClass="bg-hair-ink-rule"
      tone="stone"
      class="reveal relative mb-[clamp(32px,6vh,64px)]">AGENCIA</Eyebrow
    >

  <!-- <h2
    data-reveal
    class="reveal relative m-0 max-w-[20ch] font-display text-h2-manifesto font-normal text-pretty [--reveal-delay:.08s] [--reveal-y:26px]"
  >
    Tu marca tiene más de una cara. Nosotros encontramos <em
      class="text-gold-deep italic">la que nadie puede ignorar.</em
    >
  </h2> -->

    <h2
      data-reveal
      class="reveal relative m-0 max-w-[18ch] font-display text-h2-manifesto font-normal text-pretty [--reveal-delay:.08s] [--reveal-y:26px]"
    >
      ¿Qué hace que elijan <em class="text-gold-deep italic">tu restaurante?</em>
    </h2>
  </div>

  <div
    class="mt-[clamp(44px,8vh,96px)] grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-column border-t border-hair-ink pt-[clamp(28px,4vh,44px)]"
  >
    <!-- <p data-reveal class="reveal m-0 text-body font-light text-graphite [--reveal-delay:.1s]">
      Trabajamos con un número limitado de marcas para poder implicarnos realmente en cada proyecto. Combinamos estrategia, creatividad, contenido y tecnología para ayudar a nuestros clientes a construir marcas más relevantes y hacer crecer su negocio.
    </p> -->
    <p data-reveal class="reveal m-0 text-body font-light text-graphite [--reveal-delay:.1s]">
      Antes de elegir dónde comer, el comensal consulta la carta, mira fotos, lee reseñas y valora el ambiente. Una estrategia de marketing gastronómico presenta tu propuesta con claridad en internet y genera confianza.
    </p>

    <p data-reveal class="reveal m-0 text-body font-light text-graphite [--reveal-delay:.2s]">
      Mostramos tus platos, tu espacio y la experiencia de tu restaurante en redes y web. Así, quien te descubre online puede imaginar lo que vivirá en la mesa y decidir si quiere conocerte.
    </p>
    {/* Dos datos con el mismo patrón: cifra en display + rótulo + apoyo. */}
    <div data-reveal class="reveal flex flex-col gap-[clamp(26px,4vh,40px)] [--reveal-delay:.3s]">
      <div>
        <div class="flex items-baseline gap-[14px]">
          <span class="font-display text-metric text-ink">05</span>
          <span class="text-[11px] tracking-[.18em] text-stone uppercase">Restaurantes al año</span>
        </div>
        <p class="mt-[10px] mb-0 max-w-[30ch] text-[14px]/[1.6] font-light text-graphite-soft">
          Menos proyectos. Más atención.
        </p>
      </div>
      <div class="border-t border-hair-ink pt-[clamp(22px,3.2vh,32px)]">
        <div class="flex flex-wrap items-baseline gap-x-[14px] gap-y-2">
          <span class="font-display text-metric text-ink">1</span>
          <span class="text-[11px] tracking-[.18em] text-stone uppercase">Equipo</span>
          <span aria-hidden="true" class="text-[11px] text-stone">·</span>
          <span class="font-display text-metric text-ink">0</span>
          <span class="text-[11px] tracking-[.18em] text-stone uppercase">Intermediarios</span>
        </div>
        <p class="mt-[10px] mb-0 max-w-[30ch] text-[14px]/[1.6] font-light text-graphite-soft">
          Contacto directo durante todo el proyecto.
        </p>
      </div>
    </div>
  </div>
</SectionShell>
