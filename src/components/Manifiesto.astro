---
import { Image } from 'astro:assets';

import fotoCartaMovil from '../assets/img/agencia-carta-movil.jpg';
import Eyebrow from './ui/Eyebrow.astro';
import SectionShell from './ui/SectionShell.astro';
---

<SectionShell
  id="agencia"
  py="py-[clamp(90px,15vh,190px)]"
  class="relative overflow-hidden bg-bone text-ink"
  innerClass="relative"
>
  <div
    slot="bleed"
    aria-hidden="true"
    class="pointer-events-none absolute bottom-[-6vh] left-[-4vw] font-display text-watermark whitespace-nowrap text-watermark-ink italic select-none"
  >
    cara
  </div>

  <!-- <Eyebrow
    data-reveal
    numero="02"
    ruleClass="bg-hair-ink-rule"
    tone="stone"
    class="reveal relative mb-[clamp(32px,6vh,64px)]">AGENCIA</Eyebrow
  > -->
  {/* El bloque de encabezado da la altura de referencia: en escritorio la foto
      se centra en ella, de modo que titular y foto comparten eje y no rozan la
      hairline de abajo. En móvil la foto va en flujo, debajo del titular. */}
  <div
    class="relative flex flex-col lg:min-h-[calc(clamp(255px,33vw,540px)+clamp(56px,9vh,112px))] lg:justify-center"
  >
    {/* La foto se funde con el crema: máscara que la disuelve hacia el texto
        y hacia arriba/abajo, y `multiply` para que sus blancos tomen el tono
        del fondo. Pega con el borde derecho de la sección (sale del padding). */}
    <div
      class="foto-agencia pointer-events-none relative order-last -mx-[clamp(20px,4vw,64px)] mt-[clamp(28px,5vh,48px)] aspect-[4/3] mix-blend-multiply lg:absolute lg:top-1/2 lg:right-[calc(-1*clamp(20px,4vw,64px))] lg:z-0 lg:order-none lg:m-0 lg:w-[clamp(340px,44vw,720px)] lg:-translate-y-1/2"
    >
      <Image
        src={fotoCartaMovil}
        alt="Comensal consultando la carta del restaurante en el móvil, con un plato de pulpo a la brasa en la mesa."
        widths={[480, 720, 1080, 1440]}
        sizes="(min-width: 900px) clamp(340px, 44vw, 720px), 100vw"
        loading="lazy"
        decoding="async"
        class="size-full object-cover sepia-[.06] saturate-[.94]"
      />
    </div>

    <Eyebrow
      data-reveal
      ruleClass="bg-hair-ink-rule"
      tone="stone"
      class="reveal relative mb-[clamp(32px,6vh,64px)]">AGENCIA</Eyebrow
    >

  <!-- <h2
    data-reveal
    class="reveal relative m-0 max-w-[20ch] font-display text-h2-manifesto font-normal text-pretty [--reveal-delay:.08s] [--reveal-y:26px]"
  >
    Tu marca tiene más de una cara. Nosotros encontramos <em
      class="text-gold-deep italic">la que nadie puede ignorar.</em
    >
  </h2> -->

    <h2
      data-reveal
      class="reveal relative m-0 max-w-[18ch] font-display text-h2-manifesto font-normal text-pretty [--reveal-delay:.08s] [--reveal-y:26px]"
    >
      ¿Qué hace que elijan <em class="text-gold-deep italic">tu restaurante?</em>
    </h2>
  </div>

  <div
    class="mt-[clamp(44px,8vh,96px)] grid grid-cols-[repeat(auto-fit,minmax(280px,1fr))] gap-column border-t border-hair-ink pt-[clamp(28px,4vh,44px)]"
  >
    <!-- <p data-reveal class="reveal m-0 text-body font-light text-graphite [--reveal-delay:.1s]">
      Trabajamos con un número limitado de marcas para poder implicarnos realmente en cada proyecto. Combinamos estrategia, creatividad, contenido y tecnología para ayudar a nuestros clientes a construir marcas más relevantes y hacer crecer su negocio.
    </p> -->
    <p data-reveal class="reveal m-0 text-body font-light text-graphite [--reveal-delay:.1s]">
      Antes de elegir dónde comer, el comensal consulta la carta, mira fotos, lee reseñas y valora el ambiente. Una estrategia de <strong class="font-semibold">marketing gastronómico</strong> presenta tu propuesta con claridad en internet y genera confianza.
    </p>

    <p data-reveal class="reveal m-0 text-body font-light text-graphite [--reveal-delay:.2s]">
      Mostramos tus platos, tu espacio y la experiencia de tu restaurante en redes y web. Así, quien te descubre online puede <strong class="font-semibold">imaginar lo que vivirá en la mesa</strong> y decidir si quiere conocerte.
    </p>
    {/* Dos datos con el mismo patrón: cifra en display + rótulo + apoyo. */}
    <div data-reveal class="reveal flex flex-col gap-[clamp(26px,4vh,40px)] [--reveal-delay:.3s]">
      <div>
        <div class="flex items-baseline gap-[14px]">
          <span class="font-display text-metric text-ink">05</span>
          <span class="text-[11px] tracking-[.18em] text-stone uppercase">Restaurantes al año</span>
        </div>
        <p class="mt-[10px] mb-0 max-w-[30ch] text-[14px]/[1.6] font-light text-graphite-soft">
          Menos proyectos. Más atención.
        </p>
      </div>
      <div class="border-t border-hair-ink pt-[clamp(22px,3.2vh,32px)]">
        <div class="flex flex-wrap items-baseline gap-x-[14px] gap-y-2">
          <span class="font-display text-metric text-ink">1</span>
          <span class="text-[11px] tracking-[.18em] text-stone uppercase">Equipo</span>
          <span aria-hidden="true" class="text-[11px] text-stone">·</span>
          <span class="font-display text-metric text-ink">0</span>
          <span class="text-[11px] tracking-[.18em] text-stone uppercase">Intermediarios</span>
        </div>
        <p class="mt-[10px] mb-0 max-w-[30ch] text-[14px]/[1.6] font-light text-graphite-soft">
          Contacto directo durante todo el proyecto.
        </p>
      </div>
    </div>
  </div>
</SectionShell>

<style>
  /* Móvil: se disuelve arriba y abajo para no cortar el crema en seco. */
  .foto-agencia {
    mask-image: linear-gradient(180deg, transparent 0%, #000 18%, #000 78%, transparent 100%);
  }

  /* Escritorio: se disuelve sobre todo hacia el titular (izquierda) y,
     más suave, arriba y abajo. Las dos máscaras se intersectan. */
  @media (min-width: 900px) {
    .foto-agencia {
      mask-image:
        linear-gradient(90deg, transparent 0%, rgb(0 0 0 / .35) 18%, #000 42%),
        linear-gradient(180deg, transparent 0%, #000 16%, #000 80%, transparent 100%);
      mask-composite: intersect;
    }
  }
</style>
