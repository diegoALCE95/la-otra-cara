---
import { heroMedia } from '../data/site';
import Button from './ui/Button.astro';
---

<section
  id="top"
  class="relative flex min-h-[100svh] flex-col items-center justify-center overflow-hidden text-center"
>
  {/* Capa de media difuminada con drift. Sin video, el gradiente es el fallback del diseño. */}
  <div
    aria-hidden="true"
    class="absolute inset-[-8%] z-0 animate-hero-drift bg-[radial-gradient(70%_60%_at_40%_35%,#2a2419_0%,#141210_45%,#080808_100%)] [transform:scale(1.12)] brightness-[.62] saturate-[.72] blur-[.375rem]"
  >
    {
      heroMedia.video && (
        <video
          data-hero-video
          data-src={heroMedia.video}
          poster={heroMedia.poster ?? undefined}
          autoplay
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
          class="size-full object-cover"
        />
      )
    }
  </div>

  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-[1] bg-[radial-gradient(120%_90%_at_50%_45%,rgba(8,8,8,.28)_0%,rgba(8,8,8,.72)_55%,rgba(8,8,8,.94)_100%)]"
  >
  </div>
  <div
    aria-hidden="true"
    class="pointer-events-none absolute inset-0 z-[1] bg-[linear-gradient(180deg,rgba(8,8,8,.85)_0%,rgba(8,8,8,0)_26%,rgba(8,8,8,0)_68%,rgba(8,8,8,.95)_100%)]"
  >
  </div>

  <div
    class="section-x relative z-[2] flex w-full max-w-[73.75rem] flex-col items-center pt-[clamp(7rem,11vh,8.25rem)] pb-[clamp(6rem,14vh,9.375rem)]"
  >
    <div
      data-reveal
      class="reveal mb-[clamp(1.375rem,4vh,2.5rem)] flex items-center justify-center gap-[.875rem]"
    >
      <span aria-hidden="true" class="block h-px w-[clamp(1.5rem,4vw,3.5rem)] bg-gold"></span>
      <span class="text-[.6875rem] font-semibold tracking-[.28em] text-gold uppercase"
        >Marketing Gastronómico para Restaurantes</span
      >
      <span aria-hidden="true" class="block h-px w-[clamp(1.5rem,4vw,3.5rem)] bg-gold"></span>
    </div>

    <h1
      data-reveal
      class="reveal m-0 font-display text-hero font-normal text-balance text-white [--reveal-delay:.1s] [--reveal-dur:1.1s] [--reveal-y:1.75rem]"
    >
      Mostramos <em class="text-bone italic">la otra cara</em> de <span class="text-gold">tu restaurante.</span>
    </h1>

    <p
      data-reveal
      class="reveal mt-[clamp(1.5rem,4vh,2.75rem)] max-w-[52ch] text-body font-light text-pretty text-bone-76 [--reveal-delay:.25s]"
    >
      Estrategia, redes sociales y producción audiovisual para mostrar lo que hace especial a tu restaurante y despertar el interés de nuevos comensales.
    </p>

    <div
      data-reveal
      class="reveal mt-[clamp(1.875rem,5vh,3.25rem)] flex flex-wrap items-center justify-center gap-[.875rem] [--reveal-delay:.35s]"
    >
      <Button href="#contacto" variant="solid-bone">Cuéntanos tu proyecto →</Button>
      <Button href="#proyectos" variant="outline-bone">Ver portafolio gastronómico</Button>
    </div>

    <p data-reveal class="reveal [--reveal-delay:.55s] mt-[25px] mb-0 text-[14px]/[1.6] font-light text-graphite-soft">Videollamada gratuita de 30 minutos. Confirmación por email.</p>
  </div>

  <div
    aria-hidden="true"
    class="absolute inset-x-0 bottom-[clamp(1.5rem,5vh,2.75rem)] z-[2] flex justify-center"
  >
    <svg
      viewBox="0 0 24 24"
      width="26"
      height="26"
      fill="none"
      stroke="currentColor"
      stroke-width="1"
      stroke-linecap="round"
      stroke-linejoin="round"
      class="block animate-scroll-chevron text-gold opacity-45"
    >
      <path d="M5 9l7 7 7-7"></path>
    </svg>
  </div>
</section>

<script>
  import { initHeroVideo } from '../scripts/hero-video';

  initHeroVideo();
</script>
