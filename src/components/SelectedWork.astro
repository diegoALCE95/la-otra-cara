---
import { proyectos } from '../data/proyectos';
import Lightbox from './Lightbox.astro';
import WorkCard from './WorkCard.astro';
import SectionShell from './ui/SectionShell.astro';

/**
 * Proporción numérica derivada de la clase `aspect-[w/h]` del grid, para el
 * espaciador del visor. Se deriva en vez de duplicarse en `proyectos.ts` para
 * que no puedan desincronizarse.
 */
const proporcion = (ratio: string) => {
  const [, w = '1', h = '1'] = ratio.match(/aspect-\[(\d+)\/(\d+)\]/) ?? [];
  // Escaladas a px "intrínsecos": es lo que permite que max-w/max-h contengan
  // la caja conservando el ratio, como haría una imagen real.
  return { width: Number(w) * 200, height: Number(h) * 200 };
};
---

<SectionShell
  id="proyectos"
  py="pt-[clamp(70px,10vh,120px)] pb-[clamp(90px,14vh,170px)]"
  class="bg-ink"
>
  <div
    data-reveal
    class="reveal flex flex-wrap items-end justify-between gap-6 border-b border-hair pb-[clamp(32px,5vh,56px)]"
  >
    <h2 class="m-0 font-display text-h2 font-normal">
      <span class="text-gold">Proyectos</span>
    </h2>
    <span class="max-w-[32ch] text-[13px]/[1.6] font-light text-bone-50">
      Proyectos que hablan por nosotros. Selección 2025 — 2026.
    </span>
  </div>

  {/* El reveal va en el carrusel entero: las piezas fuera de vista quedan
      recortadas por el viewport y un observer por card no llegaría a dispararse. */}
  <div
    data-cursor-zone="work"
    data-carrusel
    data-reveal
    role="group"
    aria-label="Proyectos"
    class="reveal mt-[clamp(28px,5vh,56px)] [--reveal-y:24px]"
  >
    <div data-carrusel-viewport class="overflow-hidden">
      <ul
        data-carrusel-track
        role="list"
        class="m-0 flex list-none touch-pan-y gap-grid p-0 transition-transform duration-[900ms] ease-editorial will-change-transform"
      >
        {
          proyectos.map((proyecto, i) => (
            <li data-carrusel-slide class="carrusel-slide min-w-0">
              <WorkCard proyecto={proyecto} index={i} />
            </li>
          ))
        }
      </ul>
    </div>

    {/* Un punto por posición posible; `carrusel.ts` oculta los que sobran
        según cuántas columnas quepan. */}
    <div
      data-carrusel-dots
      aria-label="Paginación de proyectos"
      class="mt-[clamp(20px,3.5vh,36px)] flex items-center justify-center"
    >
      {
        proyectos.map((_, i) => (
          <button
            type="button"
            data-carrusel-dot={i}
            aria-current={i === 0 ? 'true' : 'false'}
            aria-label={`Ir al grupo ${i + 1}`}
            class="group flex size-[44px] cursor-pointer items-center justify-center border-0 bg-transparent focus-visible:outline-1 focus-visible:outline-offset-2 focus-visible:outline-gold"
          >
            <span
              aria-hidden="true"
              class="block size-[7px] rounded-full bg-bone-30 transition-[background-color,transform] duration-500 ease-editorial group-hover:bg-bone-55 group-aria-[current=true]:scale-[1.45] group-aria-[current=true]:bg-gold"
            />
          </button>
        ))
      }
    </div>
  </div>
</SectionShell>

{/* Cursor "Ver": solo se activa por JS en ≥900px con puntero fino. */}
<div
  data-cursor="work"
  data-on="false"
  aria-hidden="true"
  class="hover-cursor text-[9px] tracking-[.2em] uppercase"
>
  Ver
</div>

<Lightbox id="work" label="Selected Work" count={proyectos.length}>
  {
    proyectos.map((proyecto) => (
      <figure
        data-lb-slide
        hidden
        class="m-0 flex h-full w-full max-w-[1180px] flex-col gap-[clamp(14px,2.2vh,26px)]"
      >
        {/* El SVG es solo el espaciador que fija la proporción: siendo elemento
            reemplazado, al recortarlo `max-h-full` conserva el ratio en vez de
            deformarse como lo haría un div con `aspect-*`.
            TODO: al llegar las imágenes finales, este bloque se sustituye por
            `<Image ... class="max-h-full w-auto object-contain" />`. */}
        <div class="relative flex min-h-0 flex-1 items-center justify-center">
          <svg
            {...proporcion(proyecto.ratio)}
            aria-hidden="true"
            class="block h-auto max-h-full w-auto max-w-full bg-ink-well"
          />
          <span
            aria-hidden="true"
            class="absolute font-mono text-[10px] tracking-[.14em] text-bone-30 uppercase"
          >
            {proyecto.placeholder}
          </span>
        </div>
        <figcaption class="flex flex-none flex-wrap items-baseline justify-between gap-4 border-t border-hair pt-4">
          <span>
            <span class="block font-display text-card-wide text-bone">
              {proyecto.titulo}
            </span>
            <span class="mt-1.5 block text-[11px] tracking-[.2em] text-bone-45 uppercase">
              {proyecto.categoria}
            </span>
          </span>
          <span class="font-display text-[13px] text-gold">{proyecto.anio}</span>
        </figcaption>
      </figure>
    ))
  }
</Lightbox>
