---
import { Image } from 'astro:assets';

import { servicios } from '../data/servicios';
import Eyebrow from './ui/Eyebrow.astro';
import SectionShell from './ui/SectionShell.astro';
---

<SectionShell id="servicios" class="bg-ink">
  <div
    data-reveal
    class="reveal flex flex-wrap items-end justify-between gap-6 pb-[clamp(36px,6vh,64px)]"
  >
    <h2 class="m-0 font-display text-h2 font-normal">Lo que hacemos</h2>
    <Eyebrow>Servicios</Eyebrow>
  </div>

  <div data-svc-block class="flex items-start gap-column">
    <div
      data-svc-list
      data-cursor-zone="servicios"
      data-reveal-group
      class="min-w-0 flex-[1_1_520px] border-t border-hair"
    >
      {
        /* Cada fila va envuelta: el reveal usa `transition`, y el botón ya tiene
           la suya para el hover. Separarlas evita que compitan. */
        servicios.map((servicio, i) => (
          <div data-reveal class="reveal [--reveal-dur:.9s] [--reveal-y:20px]">
            <div class="border-b border-hair">
              <button
                type="button"
                data-svc={i + 1}
                data-svc-toggle
                data-cursor-target
                aria-expanded="false"
                aria-controls={`svc-panel-${i + 1}`}
                class="group flex w-full cursor-pointer items-baseline gap-[clamp(16px,3vw,48px)] border-0 bg-transparent py-[clamp(22px,3.4vh,38px)] pr-[clamp(14px,2.2vw,32px)] pl-1 text-left transition-[padding-left,background-color] duration-500 ease-editorial hover:bg-wash hover:pl-[18px] focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-gold"
              >
                <span class="w-[34px] flex-none font-display text-svc-index text-gold">
                  {String(i + 1).padStart(2, '0')}
                </span>
                <span class="min-w-0 flex-1 font-display text-svc text-bone">
                  {servicio.titulo}
                </span>
                <span
                  aria-hidden="true"
                  class="flex-none text-[14px] text-gold transition-transform duration-500 ease-editorial group-aria-expanded:rotate-90"
                >
                  →
                </span>
              </button>

              {/* Acordeón: `grid-template-rows` de 0fr a 1fr es lo único que anima
                  una altura desconocida sin medirla en JS. */}
              <div
                id={`svc-panel-${i + 1}`}
                data-svc-panel
                data-open="false"
                inert
                class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-[560ms] ease-editorial data-[open=true]:grid-rows-[1fr]"
              >
                <div class="overflow-hidden">
                  <p class="m-0 max-w-[62ch] pr-[clamp(14px,2.2vw,32px)] pb-[clamp(24px,3.6vh,36px)] pl-1 text-[15px]/[1.75] font-light text-bone-55 lg:pl-[calc(34px_+_clamp(16px,3vw,48px)_+_4px)]">
                    {servicio.texto}
                  </p>
                </div>
              </div>
            </div>
          </div>
        ))
      }
    </div>

    <div
      data-svc-stage
      aria-hidden="true"
      class="sticky top-[120px] hidden aspect-[3/4] flex-[0_0_clamp(280px,26vw,420px)] overflow-hidden lg:block"
    >
      {
        servicios.map((servicio, i) => (
          <div
            data-svc-img={i + 1}
            style={`filter:${servicio.filtro}`}
            class:list={[
              'absolute inset-0 transition-opacity duration-[600ms] ease-[ease]',
              i === 0 ? 'opacity-100' : 'opacity-0',
            ]}
          >
            <Image
              src={servicio.imagen}
              alt=""
              widths={[420, 840]}
              sizes="clamp(280px, 26vw, 420px)"
              loading="lazy"
              decoding="async"
              class="size-full object-cover"
            />
          </div>
        ))
      }
    </div>
  </div>
</SectionShell>

{/* Cursor de flecha sobre las filas: solo ≥900px con puntero fino. */}
<div data-cursor="servicios" data-on="false" aria-hidden="true" class="hover-cursor">
  <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="1">
    <path d="M4 12h16M13 5l7 7-7 7"></path>
  </svg>
</div>

<script>
  import { initServiciosAcordeon } from '../scripts/servicios-acordeon';
  import { initServiceStage } from '../scripts/servicios-hover';

  initServiceStage();
  initServiciosAcordeon();
</script>
