---
import { site } from '../data/site';
import ContactoForm from './ContactoForm.astro';
import Eyebrow from './ui/Eyebrow.astro';
import SectionShell from './ui/SectionShell.astro';

const mailto = `mailto:${site.email}`;
---

<SectionShell
  id="contacto"
  py="py-[clamp(90px,16vh,190px)]"
  class="relative overflow-hidden bg-bone text-ink"
  innerClass="relative z-10"
>
  <div class="grid items-start gap-[clamp(44px,6vw,96px)] lg:grid-cols-[minmax(0,.9fr)_minmax(0,1.1fr)]">
    <div>
      <Eyebrow data-reveal class="reveal" tone="gold-deep" tracking="tracking-[.3em]"
        >Siguiente paso</Eyebrow
      >

      <h2
        data-reveal
        class="reveal mt-[clamp(20px,4vh,40px)] mb-0 max-w-[22ch] font-display text-h2-cta font-normal text-pretty [--reveal-delay:.1s] [--reveal-y:26px]"
      >
        ¿Mostramos al mundo <em class="text-gold-deep italic">la otra cara</em> de tu marca?
      </h2>

      <p
        data-reveal
        class="reveal mt-[clamp(24px,4vh,44px)] mb-0 max-w-[40ch] text-body font-light text-pretty text-graphite [--reveal-delay:.16s]"
      >
        Cuéntanos qué tienes entre manos y te respondemos con una primera lectura del proyecto.
      </p>

      <a
        data-reveal
        href={mailto}
        class="reveal mt-[clamp(20px,3vh,32px)] inline-block border-b border-hair-ink-link pb-[3px] font-display text-mail text-ink [--reveal-delay:.22s] hover:text-ink focus-visible:outline-1 focus-visible:outline-offset-4 focus-visible:outline-gold-deep"
        >{site.email}</a
      >
    </div>

    <div data-reveal class="reveal [--reveal-delay:.28s] [--reveal-y:26px]">
      <ContactoForm />
    </div>
  </div>
</SectionShell>
