# Envío del formulario de contacto (Vercel → Settings → Environment Variables).
# Sin PUBLIC_CONTACTO_ENDPOINT el formulario valida pero avisa de que no se
# pudo enviar y ofrece el email; nunca muestra una confirmación falsa.

# Endpoint que recibe el POST en JSON.
#   Web3Forms:  https://api.web3forms.com/submit
#   Formspree:  https://formspree.io/f/<id>
#   Propio:     /api/contacto  (requiere adaptador de Vercel en Astro)
PUBLIC_CONTACTO_ENDPOINT=

# Clave pública del proveedor (Web3Forms la pide como access_key).
PUBLIC_CONTACTO_ACCESS_KEY=
