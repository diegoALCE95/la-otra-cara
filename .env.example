# Envío del formulario de contacto (Vercel → Settings → Environment Variables).
# Ver config-formulario.md.

# --- Función propia /api/contacto + Resend (opción por defecto) ---
# Sin prefijo PUBLIC_: viven solo en el servidor.
RESEND_API_KEY=
# A quién llega el aviso. Varios separados por comas.
CONTACTO_DESTINO=
# Opcional. Vacío = remitente de pruebas de Resend (onboarding@resend.dev), que
# solo entrega al email con el que se creó la cuenta de Resend.
CONTACTO_REMITENTE=

# --- Alternativa: proveedor externo (deja estas vacías para usar /api/contacto) ---
#   Web3Forms:  https://api.web3forms.com/submit
#   Formspree:  https://formspree.io/f/<id>
PUBLIC_CONTACTO_ENDPOINT=
PUBLIC_CONTACTO_ACCESS_KEY=
